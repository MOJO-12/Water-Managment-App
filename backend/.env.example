NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_NAME=WaterApp

# Postgres (docker compose overrides the host automatically)
DATABASE_URL=postgresql://water:change-me@localhost:5432/water?schema=public
POSTGRES_PASSWORD=change-me

# Generate each with: openssl rand -base64 48   (must be different from each other)
JWT_ACCESS_SECRET=
OTP_SECRET=

# SMS: "console" prints codes to the log (development only). Use "africastalking" in production.
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Comma-separated web origins allowed to call the API (admin dashboard). Leave empty for none.
CORS_ORIGINS=http://localhost:5173

# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx/ALB) so rate limits see real client IPs
TRUST_PROXY=0

# Used by `npm run seed` to create the first admin
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=0712345678
SEED_ADMIN_PASSWORD=

# Delivery pricing (whole KES) and unpaid-order expiry
DELIVERY_FEE_KES=100
FREE_DELIVERY_OVER_KES=1000
UNPAID_ORDER_TTL_MINUTES=30

# Optional test driver created by `npm run seed`
SEED_DRIVER_PHONE=
SEED_DRIVER_PASSWORD=

# M-Pesa (Daraja). Leave ALL of these empty to switch payments off. Sandbox shortcode is 174379.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public https address of this API (your ngrok address in development), no trailing slash
MPESA_CALLBACK_BASE_URL=
# Random secret used inside the callback address. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=
